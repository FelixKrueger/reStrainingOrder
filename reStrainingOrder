sub score_bisulfite_SNPs{
   
    my ($line,$chr,$genomic_pos,$read_base,$genome1,$genome2,$irrelevant,$ct_unassigned) = @_;
    my ($ref_base,$snp_base) = split (/\t/,$snps{$chr}->{$genomic_pos});
    my $first_read_conversion;
    my $genome_conversion;
    # warn "$line\n"; sleep(1);

    my $strand;
    while ( $line =~ /(XR|XG):Z:([^\t]+)/g ) {
		my $tag = $1;
		my $value = $2;
		chomp $value;

		if ($tag eq "XR") {
			$first_read_conversion = $value;
			$first_read_conversion =~ s/\r//;
		}
		elsif ($tag eq "XG") {
			$genome_conversion = $value;
			$genome_conversion =~ s/\r//;
		}
    }

    if ($first_read_conversion eq 'CT' and $genome_conversion eq 'CT') {
		$strand = 'OT';		## this is OT
    }
    elsif ($first_read_conversion eq 'GA' and $genome_conversion eq 'CT') {
		$strand = 'CTOT';		## this is CTOT
    }
    elsif ($first_read_conversion eq 'GA' and $genome_conversion eq 'GA') {
		$strand = 'CTOB';		## this is CTOB
    }
    elsif ($first_read_conversion eq 'CT' and $genome_conversion eq 'GA') {
		$strand = 'OB';		## this is OB
    }
    else {
		die "Unexpected combination of read and genome conversion: $first_read_conversion / $genome_conversion\n";
    }
    if ($verbose){  warn "strand is $strand\n"};

    ### if the SNP in question involves a genomic C position we potentially need to allow both C or T as C (G/A for the reverse strand)

    if ($verbose){ warn "Reference base is $ref_base\tSNP base:\t$snp_base\tRead base:\t$read_base\n"; sleep(1);}

    ### REFERENCE STRAIN = C
    if ( $ref_base eq 'C'){    # the position is a C in the reference genome

		### C>T SNP. Can't use the position for top strand alignments
		if ($snp_base eq 'T'){

			if ($strand eq 'OT' or $strand eq 'CTOT'){
				if ($verbose){ warn "This is a C>T SNP and can't be considered for OT or CTOT alignments!\n";}
				++$ct_snp;
				++$ct_unassigned;
				return ($genome1,$genome2,$irrelevant,$ct_unassigned);
			}

		}

		# Top strand alignments with C>T SNPs should have been skipped already. For other SNPs we accept both C or T as C.
		if ($strand eq 'OT' or $strand eq 'CTOT'){

			if ($read_base eq 'C' or $read_base eq 'T'){ # a bisulfite converted position may be a C or T (here we know that the ref base is C)
				if ($verbose){ warn "genome 1 specific!\n";}
				++$genome1;
				$counts{$chr}->{$genomic_pos}->{REF}++;
			}
			elsif($read_base eq $snp_base){
				if ($verbose){ warn "genome 2 specific!\n";}
				++$genome2;
				$counts{$chr}->{$genomic_pos}->{ALT}++;
			}
			else{
				if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				++$irrelevant;
				$counts{$chr}->{$genomic_pos}->{OTHER}++;
			}

		}
		# Alignments to the bottom strand can still be assigned normally as they do not involve the C directly
		elsif ($strand eq 'OB' or $strand eq 'CTOB'){

			if ($read_base eq $ref_base){ # == C
				if ($verbose){ warn "genome 1 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{REF}++;
				++$genome1;
			}
			# added this section 13 June 2017
			elsif ($snp_base eq 'G'){ # a bisulfite converted position on the bottom strand may be a G or A
				if ($read_base eq 'G' or $read_base eq 'A'){
					if ($verbose){ warn "genome 2 specific!\n";}
					++$genome2;
					$counts{$chr}->{$genomic_pos}->{ALT}++;
				}
				else{
					if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
					++$irrelevant;
					$counts{$chr}->{$genomic_pos}->{OTHER}++;
				}
			}
			elsif($read_base eq $snp_base){ # only A left...
				if ($verbose){ warn "genome 2 specific!\n";}
				++$genome2;
				$counts{$chr}->{$genomic_pos}->{ALT}++;
			}
			else{
				if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				$counts{$chr}->{$genomic_pos}->{OTHER}++;
				++$irrelevant;
			}
		}
		else{
			die "Unable to identify read alignment strand\n";
		}
    }

    ### AlTERNATIVE STRAIN = C
    elsif ( $snp_base eq 'C'){ # the position is a C in the alternative/SNP genome

		### C>T SNP. Can't use the position for top strand alignments
		if ($ref_base eq 'T'){

		    if ($strand eq 'OT' or $strand eq 'CTOT'){
				if ($verbose){ warn "This is a C>T SNP between alternative and reference and can't be considered for OT or CTOT alignments!\n";}
				++$ct_snp;
				++$ct_unassigned;
				return ($genome1,$genome2,$irrelevant,$ct_unassigned);
		    }

		}

		# Top strand alignments with C>T SNPs should have been skipped already. For other SNPs we accept both C or T as C.
		if ($strand eq 'OT' or $strand eq 'CTOT'){

		    if ($read_base eq 'C' or $read_base eq 'T'){ # a bisulfite converted position may be a C or T
				if ($verbose){ warn "genome 2 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{ALT}++;
				# warn "Alternative base is C\nGenomic base:\t$ref_base\tRead base:\t$read_base\n"; sleep(1);
				++$genome2;
		    }
		    elsif($read_base eq $ref_base){
				if ($verbose){ warn "genome 1 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{REF}++;
				++$genome1;
		    }
		    else{
				if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				++$irrelevant;
				$counts{$chr}->{$genomic_pos}->{OTHER}++;
		    }
		}
		elsif ($strand eq 'OB' or $strand eq 'CTOB'){ # Reads to the bottom strand can still be assigned normally

		    if ($read_base eq $snp_base){ # has to be C
				if ($verbose){ warn "genome 2 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{ALT}++;
				# warn "Alternative base is C\nGenomic base:\t$ref_base\tRead base:\t$read_base\n"; sleep(1);
				++$genome2;
		    }

		    # added this section 13 June 2017
		    elsif ($ref_base eq 'G'){ # a bisulfite converted position on the bottom strand may be a G or A
				if ($read_base eq 'G' or $read_base eq 'A'){
				    if ($verbose){ warn "genome 1 specific!\n";}
				    $counts{$chr}->{$genomic_pos}->{REF}++;
				    ++$genome1;
				}
				else{
				    if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				    ++$irrelevant;
					$counts{$chr}->{$genomic_pos}->{OTHER}++;
				}
		    }
		    elsif($read_base eq $ref_base){ # only A left...
				if ($verbose){ warn "genome 1 specific!\n";}
				++$genome1;
				$counts{$chr}->{$genomic_pos}->{REF}++;
		    }
		    else{
				if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				++$irrelevant;
				$counts{$chr}->{$genomic_pos}->{OTHER}++;
		    }
		}
		else{
		    die "Unable to identify read alignment strand\n";
		}
    }
    ### REFERENCE STRAIN = G, i.e. bottom strand C might be affected
    elsif ( $ref_base eq 'G'){    # the position is a G in the reference genome

		if ($snp_base eq 'A'){

		    if ($strand eq 'OB' or $strand eq 'CTOB'){
				if ($verbose){ warn "This is a G>A SNP and can't be considered for OB or CTOB alignments!\n";}
				++$ct_snp;
				++$ct_unassigned;
				return ($genome1,$genome2,$irrelevant,$ct_unassigned);
		    }
		}

		# Bottom strand alignments with G>A SNPs should have been skipped already
		if ($strand eq 'OT' or $strand eq 'CTOT'){  # Reads to the top strand can be assigned normally

		    if ($read_base eq $ref_base){ # eq G
				if ($verbose){ warn "genome 1 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{REF}++;
				# warn "Reference base is G\nGenomic base:\t$ref_base\tRead base:\t$read_base\n"; sleep(1);
				++$genome1;
		    }
		    # added this section 13 June 2017
		    elsif ($snp_base eq 'C'){ # a bisulfite converted position on the bottom strand may be a G or A
				if ($read_base eq 'C' or $read_base eq 'T'){
				    if ($verbose){ warn "genome 2 specific!\n";}
				    $counts{$chr}->{$genomic_pos}->{ALT}++;
				    ++$genome2;
				}
				else{
				    if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				    ++$irrelevant;
				    $counts{$chr}->{$genomic_pos}->{OTHER}++;
				}
		    }
		    elsif($read_base eq $snp_base){ # has to be T
				if ($verbose){ warn "genome 2 specific!\n";}
				++$genome2;
				$counts{$chr}->{$genomic_pos}->{ALT}++;
		    }
		    else{
				if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				++$irrelevant;
				$counts{$chr}->{$genomic_pos}->{OTHER}++;
		    }

		}
		elsif ($strand eq 'OB' or $strand eq 'CTOB'){ # Reads to the bottom strand might carry a bisulfite conversion

		    if ($read_base eq 'G' or $read_base eq 'A'){ # a bisulfite converted position may be a G or A
				if ($verbose){ warn "genome 1 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{REF}++;
				# warn "Reference base is G\nGenomic base:\t$ref_base\tRead base:\t$read_base\n"; sleep(1);
				++$genome1;
		    }
		    elsif($read_base eq $snp_base){
				if ($verbose){ warn "genome 2 specific!\n";}
				++$genome2;
				$counts{$chr}->{$genomic_pos}->{ALT}++;
		    }
		    else{
				if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				++$irrelevant;
				$counts{$chr}->{$genomic_pos}->{OTHER}++;
		    }

		}
		else{
		    die "Unable to identify read alignment strand\n";
		}

    }
    ### AlTERNATIVE STRAIN = G, i.e. bottom strand C might be affected
    elsif ( $snp_base eq 'G'){ # the position is a G in the alternative/SNP genome

		if ($ref_base eq 'A'){

		    if ($strand eq 'OB' or $strand eq 'CTOB'){
				if ($verbose){ warn "This is a G>A SNP between alternative and reference genome and can't be considered for OB or CTOB alignments!\n"; }
				++$ct_snp;
				++$ct_unassigned;
				return ($genome1,$genome2,$irrelevant,$ct_unassigned); # we are also returning 1 so we can discriminate between un-assignable and rejected C>T SNPs
		    }

		}

		# Bottom strand alignments with G>A SNPs should have been skipped already
		if ($strand eq 'OT' or $strand eq 'CTOT'){  # Reads to the top strand can be assigned normally

		    if ($read_base eq $snp_base){ # has to be G
				if ($verbose){ warn "genome 2 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{ALT}++;
				# warn "Alternative base is G\nGenomic base:\t$ref_base\tRead base:\t$read_base\n"; sleep(1);
				++$genome2;
		    }
		    # added this section 13 June 2017
		    elsif ($ref_base eq 'C'){ # a bisulfite converted position on the bottom strand may be a G or A
				if ($read_base eq 'C' or $read_base eq 'T'){
				    if ($verbose){ warn "genome 1 specific!\n";}
				    ++$genome1;
				    $counts{$chr}->{$genomic_pos}->{REF}++;
				}
				else{
				    if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				    ++$irrelevant;
				    $counts{$chr}->{$genomic_pos}->{OTHER}++;
				}
		    }
		    elsif($read_base eq $ref_base){ # has to be T
				if ($verbose){ warn "genome 1 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{REF}++;
				++$genome1;
		    }
		    else{
				if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				++$irrelevant;
				$counts{$chr}->{$genomic_pos}->{OTHER}++;
		    }
		}
		elsif ($strand eq 'OB' or $strand eq 'CTOB'){ # Reads to the bottom strand might carry a bisulfite conversion

		    if ($read_base eq 'G' or $read_base eq 'A'){ # a bisulfite converted position may be a G or A
				if ($verbose){ warn "genome 2 specific!\n";}
				# warn "Alternative base is G\nGenomic base:\t$ref_base\tRead base:\t$read_base\n"; sleep(1);
				++$genome2;
				$counts{$chr}->{$genomic_pos}->{ALT}++;
		    }
		    elsif($read_base eq $ref_base){
				if ($verbose){ warn "genome 1 specific!\n";}
				$counts{$chr}->{$genomic_pos}->{REF}++;
				++$genome1;
		    }
		    else{
				if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
				++$irrelevant;
				$counts{$chr}->{$genomic_pos}->{OTHER}++;
		    }
		}
		else{
		    die "Unable to identify read alignment gstrand\n";
		}
    }

    ### The SNP did not affect a C or G position at all
    else{
		# warn "they do exist! Ref base:\t$ref_base\tRead base:\t$read_base\n"; sleep(1);
		if ($read_base eq $ref_base){
		    if ($verbose){ warn "genome 1 specific!\n";}
		    ++$genome1;
		    $counts{$chr}->{$genomic_pos}->{REF}++;
		}
		elsif ($read_base eq $snp_base){
		    if ($verbose){ warn "genome 2 specific!\n";}
		    ++$genome2;
		    $counts{$chr}->{$genomic_pos}->{ALT}++;
		}
		else{
		    if ($verbose){ warn "The base was different than both genome 1 or genome 2: $read_base\n";}
		    ++$irrelevant;
		    $counts{$chr}->{$genomic_pos}->{OTHER}++;
		}
    }

    return ($genome1,$genome2,$irrelevant,$ct_unassigned);

}


sub read_snps{

    if ($snp_file =~ /\.gz$/){
		open (SNP,'-|','gunzip','-c',$snp_file) or die "Failed to read from gzipped $snp_file: $!\n\n";
    }
    else{
		open (SNP,'<',$snp_file) or die "Failed to read from $snp_file: $!\n\n";
    }

    ### READING FROM SNP FILE

    warn "Storing SNP positions provided in '$snp_file'\n";
    # sleep(1);

    my $snp_count = 0;
	$counting{'C57BL6'} = 0;	# Initialising Black 6 reference genome
	
	# processing header line
	$_ = <SNP>;
	chomp;
	my @headers  = (split /\t/);
	@strains = @headers[4..$#headers];
	
	while (<SNP>){
		chomp;
		$_ =~ s/\r|\n//g; # removing CR and LF line endings
		next unless (/\S/);
		++$snp_count;
		my ($chr,$pos,$ref,$snp,$calls)  = (split /\t/,$_,5);
		$calls =~ tr/\t//d if (defined $calls); # one character per strain: a string costs a fraction of the memory of an array
		die "Expected one 0/1 genotype call per strain in line $. of the SNP file\n" if (!defined $calls or $calls =~ /[^01]/ or length $calls != @strains);
		# print "$chr\t$pos\t$ref\t$snp\n"; sleep(1);

		# last if ($snp_count == $stopat);
	
		### for N-masked genomes the SNPs are stored in an. hashes
		# one string per position rather than a hash: there are millions of them
		$snps{$chr}->{$pos} = "$ref\t$snp\t$calls";
		# print "@calls\n";
		# unless (exists $counting{$strain}){
		#	$counting{$strain} = 0;
		# }

		# $strain_tallies{$strain}->{$chr}->{$pos}->{yes} = 0;
		# $strain_tallies{$strain}->{$chr}->{$pos}->{no} = 0;
		
    }

    unless (close SNP){
		# gzip exits 2 for warnings such as trailing garbage, after the data was read in full
		die "Failed to read '$snp_file' completely (",child_status(),"); the file may be truncated or corrupt\n" unless ($? >> 8 == 2 and !($? & 127));
		warn "gunzip gave a warning for '$snp_file', but its data was read in full\n";
    }
    warn "Stored $snp_count positions in total\n\n";
	# like this we can move through  the file
	#foreach my $chr(keys %snps){
	#	foreach my $pos(keys %{$snps{$chr}} ){
	#		foreach my $index (0..$#{$snps{$chr}->{$pos}->{calls} }){
				# warn "$chr\t$pos\t$index\t'$strains[$index]'\t$snps{$chr}->{$pos}->{calls}[$index]\n"; sleep(1);
	#		}
			# warn "~~~~~\n";
	#	}		
#	}
#

