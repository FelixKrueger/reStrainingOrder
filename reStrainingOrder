sub check_for_bs{

    my ($paired_end,$samtools_path) = @_;
    my $isBismark = 0; # set by any Bismark @PG line, as later tools (e.g. samtools sort) add @PG lines of their own

    # SAM/BAM format, checking the first file supplied

    my $file = $ARGV[0];

    ### if the user did not specify whether the alignment file was single-end or paired-end we are trying to get this information from the @PG header line in the SAM/BAM file
    if ($file =~ /\.gz$/){
	open (DETERMINE,"gunzip -c $file |") or die "Unable to read from gzipped file $file: $!\n";
    }
    elsif ($file =~ /\.bam$/ ){
	open (DETERMINE,"$samtools_path view -h $file |") or die "Unable to read from BAM file $file: $!\n";
    }
    else{
	open (DETERMINE,$file) or die "Unable to read from $file: $!\n";
    }

    while (<DETERMINE>){
	last unless (/^\@/);
	if ($_ =~ /^\@PG/){
	    #  warn "found the \@PG line:\n";
	    # warn "$_";

	    if ($_ =~ /Bismark/){

		$isBismark = 1;

		unless ($paired_end){ # unless the user specified --paired we try to extract this information from the @PG line

		    if ($_ =~ /\s+-1\s+/ and $_ =~ /\s+-2\s+/){
			warn "Treating file(s) as paired-end data (as extracted from \@PG line)\n\n";
			$paired_end = 1;
		    }
		    else{
			warn "Treating file(s) as single-end data (as extracted from \@PG line)\n\n";
			$paired_end = 0;
		    }
		}
	    }
	}
    }
    return ($isBismark,$paired_end);
}


sub calculate_single_strain_tallies{

	%strain_tallies = (); # from this file only
	warn "STAGE I: Calculating strain tallies to determine agreement percentage\n=====================================================================\n\n";
	return unless ($covered_positions);
	foreach my $index (0..$#strains){
		my ($ref1,$alt1) = @{$strain_counts[$index]};                       # positions where the strain looks like the ALT base
		my ($ref0,$alt0) = ($total_counts[0]-$ref1,$total_counts[1]-$alt1); # and where it looks like the reference
		$strain_tallies{$strains[$index]}->{positions_covered} = $covered_positions;
		$strain_tallies{$strains[$index]}->{agree}    = $ref0 + $alt1;
		# Bases other than ALT or REF disagree by definition
		$strain_tallies{$strains[$index]}->{disagree} = $alt0 + $ref1 + $total_counts[2];
	}
}

# Adds up the REF, ALT and OTHER counts of the covered positions for the totals, every strain and every strain pair (see @total_counts)
sub sum_genotype_calls{
	my %patterns; # genotype calls => [REF, ALT, OTHER]; positions with the same calls only need adding up once
	($covered_positions,$uncovered_positions) = (0,0);
	foreach my $chr (keys %snps){
		$uncovered_positions += keys %{$snps{$chr}};
		foreach my $pos (keys %{$counts{$chr}}){
			my $position = $counts{$chr}->{$pos};
			my $calls = $genotype_calls[int ($snps{$chr}->{$pos} / 2**24)];
			my $sums = $patterns{$calls} //= [0,0,0];
			$sums->[0] += $position->{REF}   // 0;
			$sums->[1] += $position->{ALT}   // 0;
			$sums->[2] += $position->{OTHER} // 0;
			++$covered_positions;
		}
	}
	$uncovered_positions -= $covered_positions;
	warn scalar keys %patterns," genotype patterns among the $covered_positions covered positions\n";

	@total_counts = (0,0,0);
	@strain_counts = map { [0,0,0] } @strains;
	@pair_counts = map { [map { [0,0,0] } @strains] } @strains;
	foreach my $sums (values %patterns){
		$total_counts[$_] += $sums->[$_] foreach (0..2);
	}
	foreach my $calls (keys %patterns){
		my ($ref,$alt,$other) = @{$patterns{$calls}};
		my @alt_strains;
		push @alt_strains, pos ($calls) - 1 while ($calls =~ /1/g);
		foreach my $i (0..$#alt_strains){
			my $strain1 = $alt_strains[$i];
			my $sums = $strain_counts[$strain1];
			$sums->[0] += $ref; $sums->[1] += $alt; $sums->[2] += $other;
			my $pairs = $pair_counts[$strain1];
			foreach my $strain2 (@alt_strains[$i+1..$#alt_strains]){
				$sums = $pairs->[$strain2];
				$sums->[0] += $ref; $sums->[1] += $alt; $sums->[2] += $other;
			}
		}
	}
}

sub calculate_pairwise_comparisons_and_hybrid_strain_ratios{

	my ($combo,$strain1_index,$strain2_index) = @_;
	# currently testing this with B6 CAST
	#my ($strain1_index,$strain2_index) = (10,15); 
		
	### Hybrid Strain information
	my $processed = 0;
	my $not_covered = 0;
	my $informative = 0;
	my $not_informative = 0;

	my %hybrid_agreement;
	$hybrid_agreement{0}->{name} = $strains[$strain1_index];
	$hybrid_agreement{1}->{name} = $strains[$strain2_index];

	my $yes = 0;
	my $no = 0;


	my %hybrid_identity;
	$hybrid_identity{0}->{name} = $strains[$strain1_index];
	$hybrid_identity{1}->{name} = $strains[$strain2_index];

	warn "Calculating hybrid strain agreement ratio for Strain1: >$strains[$strain1_index]< and Strain2: >$strains[$strain2_index]<\n";
	warn "Calculating strain ratios for Strain1: >$strains[$strain1_index]< and Strain2: >$strains[$strain2_index]<\n\n";
	# The REF, ALT and OTHER counts of the positions where strain 1 and strain 2 have the genotypes 0/0, 1/1, 0/1 and 1/0
	my @both_alt = @{$pair_counts[$strain1_index][$strain2_index]};
	my @only1 = map { $strain_counts[$strain1_index][$_] - $both_alt[$_] } 0..2;
	my @only2 = map { $strain_counts[$strain2_index][$_] - $both_alt[$_] } 0..2;
	my @both_ref = map { $total_counts[$_] - $only1[$_] - $only2[$_] - $both_alt[$_] } 0..2;
	my @differ = map { $only1[$_] + $only2[$_] } 0..2;

	# Hybrid agreement: does the base fit a hybrid of strain 1 and strain 2? Other bases never do
	$yes = $both_ref[0] + $both_alt[1] + $differ[0] + $differ[1];
	$no  = $both_ref[1] + $both_ref[2] + $both_alt[0] + $both_alt[2] + $differ[2];
	$processed = $covered_positions;
	$not_covered = $uncovered_positions;

	# Allele ratios: only positions where the two strains differ tell them apart
	my $count1 = $only2[0] + $only1[1];
	my $count2 = $only1[0] + $only2[1];
	$hybrid_identity{0}->{count} = $count1;
	$hybrid_identity{1}->{count} = $count2;
	warn "$hybrid_agreement{0}->{name}/$hybrid_agreement{1}->{name} hybrid strain candidate stats\n=====================================================\n";
	warn "SNP positions were covered:\t\t$processed\n";	
	warn "Positions were not covered:\t\t$not_covered\n\n";
	
	my $percent_agreement;
	
	if ( ($yes + $no) > 0){
		$percent_agreement = sprintf("%.2f",$yes / ($yes + $no) *100);
	}
	else{
		$percent_agreement = 'NA ';
	}

	warn "Potential Hybrid\tAgreeing\tNot agreeing\tPercentage agreement\n";
	warn "$hybrid_agreement{0}->{name}/$hybrid_agreement{1}->{name}\t$yes\t$no\t$percent_agreement\n";
	$pairwise{$combo}->{hybrid} = "$hybrid_agreement{0}->{name}/$hybrid_agreement{1}->{name}";
	$pairwise{$combo}->{yes} = $yes;
	$pairwise{$combo}->{no} = $no;
	$pairwise{$combo}->{percentage} = $percent_agreement;
	$pairwise{$combo}->{strain1_index} = $strain1_index;
	$pairwise{$combo}->{strain2_index} = $strain2_index;

	warn "$hybrid_identity{0}->{name}/$hybrid_identity{1}->{name} hybrid strain stats\n=====================================================\n";
	warn "SNP positions were covered:\t\t$processed\n";	
	warn "Positions were not covered:\t\t$not_covered\n";
	warn "SNP positions were informative:\t\t$informative\n";	
	warn "SNP positions were not informative (skipped):\t$not_informative\n\n";

	### allele ratios
	my $percent_strain1;
	my $percent_strain2;
	
	unless (defined $hybrid_identity{0}->{count}){
		$hybrid_identity{0}->{count} = 0;
	}
	unless (defined $hybrid_identity{1}->{count}){
		$hybrid_identity{1}->{count} = 0;
	}

	if ( ($hybrid_identity{0}->{count} + $hybrid_identity{1}->{count}) > 0){
		$percent_strain1 = sprintf("%.1f",$hybrid_identity{0}->{count} / ($hybrid_identity{0}->{count} + $hybrid_identity{1}->{count}) *100);
		$percent_strain2 = sprintf("%.1f",$hybrid_identity{1}->{count} / ($hybrid_identity{0}->{count} + $hybrid_identity{1}->{count}) *100);
	}
	else{
		$percent_strain1 = 'NA ';
		$percent_strain2 = 'NA ';
	}

	warn "Strain $hybrid_identity{0}->{name}\t$hybrid_identity{0}->{count} ($percent_strain1%)\n";
	warn "Strain $hybrid_identity{1}->{name}\t$hybrid_identity{1}->{count} ($percent_strain2%)\n";
	
	$pairwise{$combo}->{strain1_identity} = $hybrid_identity{0}->{name};
	$pairwise{$combo}->{strain2_identity} = $hybrid_identity{1}->{name};

	$pairwise{$combo}->{strain1_count} = $hybrid_identity{0}->{count};
	$pairwise{$combo}->{strain2_count} = $hybrid_identity{1}->{count};

	$pairwise{$combo}->{strain1_percentage} = $percent_strain1;
	$pairwise{$combo}->{strain2_percentage} = $percent_strain2;

	# warn "OLD:\n$hybrid_identity{0}->{name}\t$hybrid_identity{0}->{count}\t$percent_strain1\t$hybrid_identity{1}->{name}\t$hybrid_identity{1}->{count}\t$percent_strain2\n";	
	# print RATIOS "$hybrid_identity{0}->{name}\t$hybrid_identity{0}->{count}\t$percent_strain1\t$hybrid_identity{1}->{name}\t$hybrid_identity{1}->{count}\t$percent_strain2\n";	

}



