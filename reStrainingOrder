				   'sam'                     => \$sam,
				   'paired'                  => \$paired,
				   'hic'                     => \$hic_data,
				   'conflicting|weird'       => \$conflict,
				   'singletons'              => \$singletons,
				   'bisulfite'               => \$bisulfite,
				   'skip_hybrid_detection'   => \$skip_hybrid_detection,
	);

    ### EXIT ON ERROR if there were errors with any of the supplied options
    unless ($command_line){
		die "Please respecify command line options\n";
    }

    ### HELPFILE
    if ($help){
		print_helpfile();
		exit;
    }

    if ($version){
	print << "VERSION";

    reStrainingOrder - Mouse Strain Classification

	        Version: $pipeline_version
 	  Copyright 2018-23, Felix Krueger
            Altos Bioinformatics
    https://github.com/FelixKrueger/reStrainingOrder


VERSION
	  exit;
    }

    ### no files provided
    unless (@ARGV){
		warn "You need to provide one or more SAM/BAM files to start the allele-specific pipeline. Please respecify!\n";
		sleep(1);
		print_helpfile();
		exit;
    }


    unless ($snp_file){
		die "You need to provide a matrix file detailing SNPs on chromosome 1 with e.g. '--SNP_file MGPv8_SNP_matrix_chr1.txt.gz'. Please respecify!\n";
    }

    ### checking to see if all files are indeed present in the folder
    foreach my $file (@ARGV){
		unless(-e $file){
			die "Input file '$file' doesn't exist in the input folder. Please check filenames and try again!\n\n";
		}
    }

    ### PATH TO SAMTOOLS
    if (defined $samtools_path){
		# if Samtools was specified as full command
		if ($samtools_path =~ /samtools$/){
			if (-e $samtools_path){
				# Samtools executable found
			}
			else{
				die "Could not find an installation of Samtools at the location $samtools_path. Please respecify\n";
			}
		}
		else{
			unless ($samtools_path =~ /\/$/){
				$samtools_path =~ s/$/\//;
			}
			$samtools_path .= 'samtools';
			if (-e $samtools_path){
				# Samtools executable found
			}
			else{
				die "Could not find an installation of Samtools at the location $samtools_path. Please respecify\n";
			}
		}
    }
    # Check whether Samtools is in the PATH if no path was supplied by the user
    else{
		if (!system "which samtools >/dev/null 2>&1"){ # STDOUT is binned, STDERR is redirected to STDOUT. Returns 0 if samtools is in the PATH
			$samtools_path = `which samtools`;
			chomp $samtools_path;
		}
    }

    unless (defined $samtools_path){
		die "Could not find an installation of Samtools on your system. Please either install Samtools first or provide the path to an existing installation\n\n";
    }

    ### --singletons only make sense for paired-end data
    if ($singletons){
		
		unless ($paired){
		    warn "The option --singletons only makes sense for paired-end files. Simply ignoring it in single-end mode...\n"; sleep(1);
		    $singletons = undef;
		}
    }

    ### OUTPUT DIRECTORY PATH
    chdir $parent_dir or die "Failed to move back to current working directory\n";
    if (defined $output_dir){
		unless ($output_dir eq ''){
	    	unless ($output_dir =~ /\/$/){
			$output_dir =~ s/$/\//;
	    	}
		}

		if (chdir $output_dir){
			$output_dir = getcwd(); #  making the path absolute
			unless ($output_dir =~ /\/$/){
			$output_dir =~ s/$/\//;
			}
		}
		else{
			mkdir $output_dir or die "Unable to create directory $output_dir $!\n";
			warn "Created output directory $output_dir!\n\n";
			chdir $output_dir or die "Failed to move to $output_dir\n";
			$output_dir = getcwd; #  making the path absolute
			unless ($output_dir =~ /\/$/){
			$output_dir =~ s/$/\//;
			}
		}
		warn "Output will be written into the directory: $output_dir\n";
    }
    else{
		$output_dir = '';
    }
    chdir $parent_dir or die "Failed to move back to current working directory\n";

    if ($sam){
		$bam = 0;
    }
    else{
		$bam = 1;
    }

    return ($snp_file,$no_sort,$verbose,$samtools_path,$bam,$paired,$conflict,$output_dir,$singletons,$bisulfite,$skip_hybrid_detection);
}



# How a child process ended, from $?
sub child_status{
    return 'could not be run' if ($? == -1);
    return 'killed by signal '.($? & 127) if ($? & 127);
    return 'exit status '.($? >> 8);
}

sub print_helpfile{
    print <<EOF

      SYNOPSIS:

	reStrainingOrder is designed to read in alignment files in BAM format and determine the genetic origin of reads
	that cover known SNP positions. For this to work the alignment step must have been carried out against a multi-
	strain mouse genome that had all SNP positions replaced by Ns (N-masking), in a process carried out by the 'reStraining'
	genome preparation. A matrix of all relevant SNP positions on chromosome 1 also needs to be provided using the option
	--snp_file.

	For more information on the workflow and file formats, please see the User Guide documentation here:
    	https://github.com/FelixKrueger/reStrainingOrder/blob/master/Docs/README.md


      USAGE:      reStrainingOrder  [options] --snp_file MGMGPv8_SNP_matrix_chr1.txt.gz [input file(s)]


    input file(s)          Mapping output file to the N-masked MGP genome in BAM format. 

    --snp_file <file>      Mandatory matrix file specifying SNP positions to be considered on chromosome 1; may be a plain
                           text file or gzip compressed. The SNP matrix is expected to be in the following format:

                           Chromosome  Position   REF   ALT   [0 or 1 for each strain]

                           Where 0 means REF base, and 1 means ALT base. Edit 23 March 2022: A matrix file generated with the 
	                       v7 index file (see 'reStraining --help') is also acceptable.

    
    -o/--outdir <dir>      Write all output files into this directory. By default the output files will be written into
                           the same folder as the input file(s). If the specified folder does not exist, it will be
                           created first. The path to the output folder can be either relative or absolute.
                           --output_dir is accepted as well.

  
    --bisulfite            Assumes Bisulfite-Seq data processed with Bismark (www.bioinformatics.babraham.ac.uk/projects/bismark/)
                           as input. reStrainingOrder will run a quick check at the start of a run to see if the
                           file provided appears to be a Bismark file, and set the flag --bisulfite automatically.

    --samtools_path        The path to your Samtools installation, e.g. /home/user/samtools/. Does not need to
                           be specified explicitly if Samtools is in the PATH already.

    --verbose              Verbose output (for debugging).


    --help                 Displays this help information and exits.

    --version              Displays version information and exits.


                                   Script last modified: 11 April 2023


EOF
    ;
  exit 1;
}

