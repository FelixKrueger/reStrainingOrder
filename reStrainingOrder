}

# Reference offsets (from the alignment start) of the Ns in an MD tag
sub md_n_offsets{
    my ($md_tag) = @_;
    my $offset = 0;
    my @ns;
    while ($md_tag =~ /(\d+)|\^([A-Za-z]+)|([A-Za-z])/g){
		if (defined $1){
			$offset += $1;
		}
		elsif (defined $2){ # deleted bases are in the reference only
			$offset += length $2;
		}
		else{
			push @ns, $offset if ($3 eq 'N');
			++$offset;
		}
    }
    return @ns;
}

# Where the base at an MD offset is, as (index in the read, offset from the alignment start in the genome);
# empty if that base is deleted. The MD tag counts deleted bases but not skipped ones (N, e.g. introns)
sub locate_md_offset{
    my ($cigar,$offset) = @_;
    my ($md,$read,$genome) = (0,0,0);
    while ($cigar =~ /(\d+)([MIDNSHP=X])/g){
		my ($len,$op) = ($1,$2);
		if ($op eq 'M' or $op eq '=' or $op eq 'X'){
			return ($read + $offset - $md, $genome + $offset - $md) if ($offset < $md + $len);
			$md     += $len;
			$read   += $len;
			$genome += $len;
		}
		elsif ($op eq 'I' or $op eq 'S'){ # bases in the read only
			$read += $len;
		}
		elsif ($op eq 'D'){ # bases in the reference and the MD tag only
			return () if ($offset < $md + $len);
			$md     += $len;
			$genome += $len;
		}
		elsif ($op eq 'N'){ # bases in the reference only
			$genome += $len;
		}
    }
    return ();
}

# 1 if SEQ, CIGAR and MD tag agree with each other and with the SAM format; else (0, the reason)
sub read_is_consistent{
    my ($cigar,$md_tag,$sequence) = @_;
    return (0,'no sequence') if ($sequence eq '*');
    return (0,'no CIGAR') if ($cigar eq '*');
    return (0,'CIGAR not in SAM format') unless ($cigar =~ /^(?:\d+[MIDNSHP=X])+$/);
    return (0,'MD tag not in SAM format') unless ($md_tag =~ /^\d+(?:(?:[A-Z]|\^[A-Z]+)\d+)*$/);

    my ($cigar_aligned,$query) = (0,0);
    my @cigar_dels;
    while ($cigar =~ /(\d+)([MIDNSHP=X])/g){
		my ($len,$op) = ($1,$2);
		if ($op eq 'M' or $op eq '=' or $op eq 'X'){
			$cigar_aligned += $len;
			$query         += $len;
		}
		elsif ($op eq 'I' or $op eq 'S'){
			$query += $len;
		}
		elsif ($op eq 'D'){
			add_deletion(\@cigar_dels,$cigar_aligned,$len);
		}
    }

    my $md_aligned = 0;
    my @md_dels;
    while ($md_tag =~ /(\d+)|\^([A-Za-z]+)|([A-Za-z])/g){
		if (defined $1){
			$md_aligned += $1;
		}
		elsif (defined $2){
			add_deletion(\@md_dels,$md_aligned,length $2);
		}
		else{
			++$md_aligned;
		}
    }

    return (0,'MD/CIGAR mismatch') unless ($md_aligned == $cigar_aligned and "@{[map {@$_} @md_dels]}" eq "@{[map {@$_} @cigar_dels]}");
    return (0,'SEQ length mismatch') unless (length $sequence == $query);
    return (1);
}

# Records a deletion as [aligned bases before it, length]; deletions with no aligned base between them are one
sub add_deletion{
    my ($dels,$aligned_before,$len) = @_;
    if (@$dels and $dels->[-1][0] == $aligned_before){
		$dels->[-1][1] += $len;
    }
    else{
		push @$dels, [$aligned_before,$len];
    }
}




