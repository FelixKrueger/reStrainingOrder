        # wparn "CHR: $chr\n"; 
	 #   print ALLSNP "$snps{$location}->{snp}\n";
     #   print {$fhs{$chr}} "$snps{$location}->{snp}\n"; # also writing into the SNP folder
    #}
   
}


# Filters one position of the VCF file, adding to the counts in %$tally. Returns 1 first at the first position past
# chromosome 1, then the chromosome and the line to write if a strain had a high confidence SNP call there
sub filter_VCF_line{
    my ($line,$tally) = @_;
    ++$tally->{count};
        # the strain calls are left as one string: going over them one by one was most of the run time
        my ($chr,$pos,undef,$ref,$alt,undef,undef,$info,$format,$calls) = (split /\t/,$line,10);

		#  warn "genotype: $gt\nfilter:   $fi\n";
		#  warn "$fi\n"; sleep(1);
        unless (defined $last_chr){
            $last_chr = $chr; # only once
            warn "Processing first chromosome (chr $chr)\n";
        }
        
        unless ($chr eq $last_chr){
            warn "Reached a new chromosome (chr $chr)\n";
            $last_chr = $chr; 
        }
        # warn "$chr , $pos , $ref , $alt\n"; sleep(1);
        unless ($chr eq '1' or $chr eq 'chr1'){ # Ensembl or UCSC names, as for THE MATRIX below
            warn "Reached a new chromosome ($chr), but we are currently limiting filtering to chromosome 1\n";
            return (1);
        }

		# skipping if the reference base is not well defined in Black6
		if ($ref =~ /[^ATCG]/){ # reference base contained any non A, C, T, G characters or more than one base
			# warn "ref was: $ref; skipping\n";
            ++$tally->{skipped};
			return (0);
		}
		
        # The v7 file contains both SNPs as wella s INDELS. We are only interested in SNPs here, so removing all INDELs
        if ($v7){
            if ($info =~ /INDEL/){
                # warn "This variant is an INDEL:\n$info\nRemoving...\n"; sleep(1);
                ++$tally->{indel};
                return (0);
            }
        }

		# skipping if the SNP is not well defined in the strain of interest
		# if ($alt =~ /[^ATCG,]/){ # Alt base contained any non A, C, T, G characters or commas which separate several different variants
        # SNPs may also have more than 1 separate ALT bases. To get the maximum out of the SNP analysis, one 
        # should probably include these positions. For reStrainingOrder it should be enough to only look at 
        # positions that have one REF and one ALT base.        
    
		if ($alt =~ /[^ATCG]/){ # Alt base contained any non A, C, T, G characters or commas which separate several different variants
            # warn "SNP was: $alt; skipping\n";
			++$tally->{skipped};
			# next;
            # warn "ALT base not clearly defined:\t$_\n"; sleep(1);
            return (0);
		}
       
        # One call per strain, 1 only for a homozygous ALT genotype (1/1) with a high confidence filter value (FI = 1)
        $calls //= '';
        chop $calls while (substr ($calls,-1) eq "\t"); # as split does, ignoring empty trailing fields
        my $fields = "\t$calls";
        if (index ($fields,"\t2/2") >= 0 or index ($fields,"\t3/3") >= 0){
            if ($fields =~ m{\t([23]/[23])(?![^:\t])}){
                warn "$1\n";
                die "Should never happen\n";
            }
        }
        my $strain_count = $calls eq '' ? 0 : 1 + ($calls =~ tr/\t//);
        my $straincalls = "0\t" x $strain_count;
        chop $straincalls;
        my $should_stay = 0;
        my ($strain,$from) = (0,0);
        while ($fields =~ /$passed_call/g){
            my $start = $-[0];
            $strain += substr ($fields,$from,$start - $from + 1) =~ tr/\t//; # the number of the strain whose call matched
            $from = $start + 1;
            substr ($straincalls,2 * $strain - 2,1,'1');
            $should_stay = 1;
        }
        # sleep(1);
        # Now that we have processed all strains we can print this position to THE MATRIX
        unless ($should_stay){
            ++$tally->{discarded};
            return (0);
        }
        ++$tally->{matrix} if ($chr eq 1 or $chr eq "chr1"); # Only positions on chromosome 1 go to THE MATRIX (Ensembl or UCSC name)
        return (0,$chr,join ("\t",$chr,$pos,$ref,$alt,$straincalls));
}

sub write_SNP_line{
    my ($chr,$snp,$fhs) = @_;
    print THEMATRIX "$snp\n" if ($chr eq 1 or $chr eq "chr1");
    print {$fhs->{$chr}} "$snp\n"; # also writing into the SNP folder
}

# Shares the VCF positions out between forked workers in large blocks, and writes what they return in the order of the
# file, so the output is the same as with one process. Once a block reaches a position past chromosome 1, the blocks
# after it are dropped, as one process would never have read them
sub filter_VCF_in_parallel{
    my ($carry,$in,$tally,$fhs) = @_;
    ($last_chr) = split (/\t/,$carry,2);
    warn "Processing first chromosome (chr $last_chr)\n";

    my @workers;
    foreach my $worker (1..$parallel){
        pipe (my $block_reader,my $block_writer) or die "Failed to create a pipe for worker $worker: $!\n";
        pipe (my $result_reader,my $result_writer) or die "Failed to create a pipe for worker $worker: $!\n";
        my $pid = fork;
        die "Failed to start worker $worker: $!\n" unless (defined $pid);
        if ($pid == 0){
            close $_->[1] foreach (@workers); # the main process's ends of the other workers' pipes
            close $_->[2] foreach (@workers);
            close $block_writer;
            close $result_reader;
            my $ok = eval{
                while (length (my $block = receive_message($block_reader))){
                    my %counts = (count => 0, matrix => 0, discarded => 0, indel => 0, skipped => 0);
                    my $warnings = ''; # passed on with the positions, so the main process gives them in order
                    local $SIG{__WARN__} = sub { $warnings .= $_[0] };
                    my $stop = 0;
                    my @segments; # [chromosome, lines]: one per run of lines on the same chromosome
                    foreach my $line (split /\n/,$block){
                        $line =~ tr/\r//d;
                        ($stop,my $chr,my $snp) = filter_VCF_line($line,\%counts);
                        last if ($stop);
                        next unless (defined $snp);
                        push @segments,[$chr,''] unless (@segments and $segments[-1][0] eq $chr);
                        $segments[-1][1] .= "$snp\n";
                    }
                    send_message($result_writer,join ("\t",@counts{qw(count matrix discarded indel skipped)},$stop,length $warnings,map { ($_->[0],length $_->[1]) } @segments)."\n".$warnings.join ('',map { $_->[1] } @segments));
                }
                1;
            };
            warn $@ unless ($ok);
            # _exit, not exit: the output filehandles belong to the main process and must not be flushed a second time
            POSIX::_exit($ok ? 0 : 1);
        }
        close $block_reader;
        close $result_writer;
        push @workers,[$pid,$block_writer,$result_reader];
    }

    # The rest of the file in blocks of whole lines
    my $next_block = sub{
        while (1){
            my $read = read ($in,my $data,8 * 1024 * 1024);
            die "Failed to read from the VCF file: $!\n" unless (defined $read);
            $data = $carry.$data;
            $carry = '';
            return (length $data ? $data : undef) if ($read == 0);
            my $cut = rindex ($data,"\n");
            if ($cut < 0){
                $carry = $data; # no full line yet
                next;
            }
            $carry = substr ($data,$cut + 1);
            return substr ($data,0,$cut + 1);
        }
    };

    my ($sent,$received,$stopped) = (0,0,0);
    foreach my $worker (@workers){
        my $block = $next_block->();
        last unless (defined $block);
        send_message($worker->[1],$block);
        ++$sent;
    }
    while ($received < $sent){
        my $worker = $workers[$received % @workers];
        my $result = receive_message($worker->[2]);
        die "A worker stopped without returning its positions, see the messages above\n" unless (length $result);
        ++$received;
        next if ($stopped); # blocks past the end of chromosome 1
        my $nl = index ($result,"\n");
        my ($count,$matrix,$discarded,$indel,$skipped,$stop,$warnings_length,@segments) = split (/\t/,substr ($result,0,$nl));
        foreach my $million (int ($tally->{count} / 1000000) + 1 .. int (($tally->{count} + $count) / 1000000)){
            warn "processed ${million}000000 lines\n";
        }
        $tally->{count} += $count;
        $tally->{matrix} += $matrix;
        $tally->{discarded} += $discarded;
        $tally->{indel} += $indel;
        $tally->{skipped} += $skipped;
        my $offset = $nl + 1;
        print STDERR substr ($result,$offset,$warnings_length);
        $offset += $warnings_length;
        while (@segments){
            my ($chr,$length) = splice (@segments,0,2);
            my $lines = substr ($result,$offset,$length);
            $offset += $length;
            print THEMATRIX $lines if ($chr eq 1 or $chr eq "chr1");
            print {$fhs->{$chr}} $lines; # also writing into the SNP folder
        }
        $stopped = $stop;
        next if ($stopped);
        my $block = $next_block->();
        if (defined $block){
            send_message($worker->[1],$block);
            ++$sent;
        }
    }

    my $failed = 0;
    foreach my $worker (@workers){
        my ($pid,$block_writer,$result_reader) = @$worker;
        send_message($block_writer,''); # nothing left to do
        close $block_writer;
        close $result_reader;
        waitpid ($pid,0);
        ++$failed if ($?);
    }
    die "$failed of the workers failed, see the messages above\n" if ($failed);
}

# Messages between the main process and the workers: a length, then that many bytes
sub send_message{
    my ($fh,$data) = @_;
    my $message = pack ('N',length $data).$data;
    my $offset = 0;
    while ($offset < length $message){
        my $written = syswrite ($fh,$message,length ($message) - $offset,$offset);
        die "Failed to write to a worker pipe: $!\n" unless (defined $written);
        $offset += $written;
    }
}

sub receive_message{
    my ($fh) = @_;
    my $length = read_bytes($fh,4);
    return '' unless (length $length == 4); # the other end has gone
    return read_bytes($fh,unpack ('N',$length));
}

sub read_bytes{
    my ($fh,$wanted) = @_;
    my $data = '';
    while (length $data < $wanted){
        my $read = sysread ($fh,$data,$wanted - length $data,length $data);
        die "Failed to read from a worker pipe: $!\n" unless (defined $read);
        last if ($read == 0);
    }
    return $data;
}

sub detect_chroms{
    
    my %chrom; # detecting the chromosomes from the VCF file
    my @chrom;
    
    if ($vcf_file =~ /gz$/){
	open (DETECT,"gunzip -c $vcf_file |") or die "Failed to open file '$vcf_file': $!\n";
    }
    else{
	open (DETECT, $vcf_file) or die "Failed to read Input VCF file '$vcf_file': $!\n";
    }
    
    # warn "Detecting chromosomes from file '$vcf_file'\n\n";
    while (<DETECT>){
	$_ =~ s/(\r|\n)//g; # removing end of line characters
	last unless ($_ =~ /^\#/);
	
	if ($_ =~ /^\#\#contig/){ # filters header lines
	    # warn "$_\n"; # sleep(1);
	    $_ =~ /ID=(.+),/;
	    my $chr = $1;
	    # warn "Identified chromosome $chr\n";
	    unless (exists $chrom{$chr}){
		$chrom{$chr}++;
		push @chrom, $chr; # in the order of the VCF header
	    }
	}
    }
    
    # close DETECT or warn "Failed to close filehandle DETECT: $!\n";
    return @chrom;
    
}

sub detect_strains{
    
    my $vcf_file = shift;
    my %strains; # detecting the available strains from the VCF file
    
    if ($vcf_file =~ /gz$/){
	open (STRAIN,"gunzip -c $vcf_file |") or die "Failed to open file '$vcf_file': $!\n";
    }
    else{
	open (STRAIN, $vcf_file) or die "Failed to read Input VCF file '$vcf_file': $!\n";
    }
    
    # warn "Detecting strains from file '$vcf_file'\n\n";
    while (<STRAIN>){
	$_ =~ s/(\r|\n)//g; # removing end of line characters
	next if ($_ =~ /^\#\#/);	
	if ($_ =~ /^\#CHROM/){ # header line listing all different strains
	    # warn "$_\n"; sleep(1);
	}
	last unless ($_ =~ /^\#/); # everything from now on are the SNPs themselves
	
	my @strains = split (/\t/);

    # warn "Here ist the \@strains ARRRAY:\n", join ("\n",@strains),"\n"; 
    # The first 8 fields are irrelevant: #CHROM  POS     ID      REF     ALT     QUAL    FILTER  INFO    FORMAT  
    for(0..8){
        my $removed = shift @strains;
    }

        foreach my $index(0..$#strains){
            $strains{$index}->{strain} = $strains[$index];
            $strains{$index}->{count} = 0;
            # warn "$index\t$strains[$index]\n";
        }
    }
    
    # close STRAIN or warn "Failed to close filehandle STRAIN: $!\n";
    return %strains;

}

sub read_genome_into_memory{
    
    ## working directoy
    my $cwd = shift;
    
    ## reading in and storing the specified genome in the %chromosomes hash
    chdir ($genome_folder) or die "Can't move to $genome_folder: $!";
    warn "Now reading in and storing sequence information of the genome specified in: $genome_folder\n\n";

    my @chromosome_filenames =  <*.fa>;

    ### if there aren't any genomic files with the extension .fa we will look for files with the extension .fasta
    unless (@chromosome_filenames){
      @chromosome_filenames =  <*.fasta>;
    }

    unless (@chromosome_filenames){
      die "The specified reference genome folder $genome_folder does not contain any sequence files in FastA format (with .fa or .fasta file extensions)\n";
    }

    my $SQ_count = 0;

    foreach my $chromosome_filename (@chromosome_filenames){

	open (CHR_IN,$chromosome_filename) or die "Failed to read from sequence file $chromosome_filename $!\n";
	# One chromosome at a time rather than line by line: each record runs up to the next line starting with '>'
	local $/ = "\n>";
	my $first = 1;
	while (my $record = <CHR_IN>){
	    chomp $record; # the "\n>" that starts the next chromosome
	    $record = ">$record" unless ($first); # the '>' went with the end of the previous record
	    $first = 0;
	    my $header = $record =~ s/^([^\n]*)\n?// ? $1 : '';
	    $header =~ s/\r//;
	    my $chromosome_name = extract_chromosome_name($header);
	    $record =~ tr/\r\n//d; # removing line endings
	    $record =~ tr/a-z/A-Z/;

	    if (exists $chromosomes{$chromosome_name}){
		print "chr $chromosome_name (",length $record ," bp)\n";
		die "Exiting because chromosome name already exists. Please make sure all chromosomes have a unique name!\n";
	    }
	    if (length($record) == 0){
		warn "Chromosome $chromosome_name in the multi-fasta file $chromosome_filename did not contain any sequence information!\n";
	    }
	    print "chr $chromosome_name (",length $record ," bp)\n";
	    $chromosomes{$chromosome_name} = $record;
	}
	close CHR_IN;
    }
    print "\n";
    chdir $cwd or die "Failed to move to directory $cwd\n";

}

sub extract_chromosome_name {
    ## Bowtie seems to extract the first string after the inition > in the FASTA file, so we are doing this as well
    my $fasta_header = shift;
    if ($fasta_header =~ s/^>//){
	my ($chromosome_name) = split (/\s+/,$fasta_header);
	return $chromosome_name;
    }
    else{
	die "The specified chromosome ($fasta_header) file doesn't seem to be in FASTA format as required!\n";
    }
}


